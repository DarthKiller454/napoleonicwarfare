                            <Children>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="108" SuggestedHeight="108" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="Mission.Radial.Item.Glow" IsSelected="@IsFocused" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" Command.HoverBegin="Focus" Command.HoverEnd="Unfocus">
