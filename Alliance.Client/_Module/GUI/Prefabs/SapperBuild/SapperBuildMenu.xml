                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\arrow_little" Color="#FEC157FF" Rotation="@DirectionRotation" IsVisible="@HasFocusedOption" DoNotAcceptEvents="true" />
