                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="260" SuggestedHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="-61" Brush="Order.SelectedOrder.Text" Brush.FontSize="19" Text="SAPPER BUILDING" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="28" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="28" Brush="Order.SelectedOrder.Text" Brush.FontSize="20" Text="@FocusedName" IsVisible="@HasFocusedOption" DoNotAcceptEvents="true" />
